              "@media (min-width: 992px)": {
                "padding": "4rem",
                "padding-top": "(@contentPaddingTop * 3rem)",
                "padding-bottom": "(@contentPaddingBottom * 3rem)"
              }
            },
            ".wrap": {
              "background": "url(@wrapBgImage)",
              "background-repeat": "no-repeat",
              "background-position": "center",
              "background-size": "cover",
              ".inner-wrap": {
                "padding": "40px"
              }
            },
            ".card-title": {
