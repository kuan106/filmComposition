              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "border-radius": "4px",
              "@media (max-width: 767px)": {
                "padding": "1.5rem",
                "padding-top": "(@contentPaddingTop * 1.5rem)",
                "padding-bottom": "(@contentPaddingBottom * 1.5rem)"
              },
              "@media (min-width: 768px) and (max-width: 991px)": {
